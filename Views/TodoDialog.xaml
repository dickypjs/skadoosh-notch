<Window x:Class="SkadooshNotch.Views.TodoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Tugas"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="280" Height="170"
        WindowStartupLocation="CenterScreen">
  <Border Background="#F0181818" CornerRadius="10" Padding="14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="Black" Opacity="0.5"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="Tambah To-Do" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBox x:Name="TbTitle" Background="#22FFFFFF" Foreground="White" BorderThickness="0"
               Padding="6" FontSize="11" Margin="0,0,0,8"/>
      <DatePicker x:Name="DpDeadline" Background="#22FFFFFF" Foreground="White" BorderThickness="0"
                  Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Batal" Style="{StaticResource GhostBtn}" Padding="8,4" FontSize="10" Margin="0,0,6,0" Click="BtnCancel_Click"/>
        <Button Content="Simpan" Background="#FF4CAF50" Foreground="White" BorderThickness="0"
                Padding="12,4" FontSize="10" Cursor="Hand" Click="BtnSave_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
