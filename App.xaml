<Application x:Class="SkadooshNotch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Colors -->
      <Color x:Key="NotchBg">#CC0D0D0D</Color>
      <Color x:Key="NotchAccent">#FF4CAF50</Color>
      <SolidColorBrush x:Key="NotchBgBrush" Color="{StaticResource NotchBg}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource NotchAccent}"/>
      <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="TextSecondary" Color="#AAC8C8C8"/>

      <!-- Base panel style -->
      <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="#CC141414"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="Black" Opacity="0.5"/>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Transparent button -->
      <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#44FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
